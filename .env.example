# Copy this file to .env and fill in your own keys.
# Never upload .env to GitHub.

GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# Current Gemini defaults. Change these if needed.
GEMINI_OUTLINE_MODEL=gemini-3.8-flash
GEMINI_STORY_MODEL=gemini-3.1-pro-preview

# Hosted image generation. This avoids downloading a local diffusion model.
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3.5-large-turbo
HF_PROVIDER=auto

PANELS=5
DEMO_MODE=false
REQUEST_TIMEOUT=180
